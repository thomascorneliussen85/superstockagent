# Copied to .env automatically by start-backend.bat on first run. Edit .env, not this file.

# demo     = synthetic prices (no MT5 needed)
# mt5      = MetaTrader 5 on this PC; demo/live account detected automatically
# mt5_demo = MT5, but refuse to run unless the logged-in account is a DEMO account
# mt5_live = MT5, but refuse to run unless the logged-in account is a LIVE account
# All modes are READ-ONLY: the program never places, modifies or closes trades.
COPILOT_MODE=mt5

# Your broker's name for gold if it is not "XAUUSD" (see MT5 Market Watch), e.g. XAUUSD.m or GOLD
# COPILOT_MT5_SYMBOL=XAUUSD

# Broker server time minus UTC in minutes. Normally auto-detected while the market is open.
# COPILOT_MT5_UTC_OFFSET_MINUTES=120

# Only needed if MT5 is not found automatically:
# COPILOT_MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# Pin your extension ID (shown on the extension's options page) for stronger security:
# COPILOT_ALLOWED_EXTENSION_IDS=["abcdefghijklmnopabcdefghijklmnop"]

# ---------------- AI-kommentarer (Claude) ----------------
# Lim inn API-nøkkelen din fra https://console.anthropic.com (Settings -> API keys).
# Nøkkelen blir værende på denne PC-en og sendes aldri til nettleseren.
# ANTHROPIC_API_KEY=sk-ant-...

# Hardt tak på AI-kostnad per måned (fordeles jevnt på hverdagene).
COPILOT_AI_MONTHLY_BUDGET_NOK=50
COPILOT_AI_USD_NOK=10.5

# Modell og tenkedybde. claude-opus-5-5 gir best kvalitet (~0,15-0,3 kr per kommentar,
# ca. 10-15 automatiske kommentarer per handelsdag innenfor 50 kr/mnd).
# claude-sonnet-5-5 koster omtrent halvparten; claude-haiku-5-5 ca. 1/40 (enklere tekst).
COPILOT_AI_MODEL=claude-opus-5-5
COPILOT_AI_EFFORT=low

# Minste tid mellom automatiske AI-kall (sekunder). "Spør AI nå" hopper over denne.
COPILOT_AI_MIN_INTERVAL_SECONDS=120
