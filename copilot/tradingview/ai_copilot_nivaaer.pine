// AI Trading Copilot - nivåer, trendlinjer og volum-POC for TradingView.
// Samme regler som backend-analysen (svingpunkter 3/3, nivåer klynget innen 0,3 x ATR 14,
// trendlinjer gjennom de to siste stigende bunnene / fallende toppene).
// Legg til: Pine Editor (nederst i TradingView) -> lim inn alt -> Lagre -> "Legg til i diagram".
// For full volumprofil kan du i tillegg bruke TradingViews innebygde "Visible Range Volume Profile".
// Dette er beskrivende verktøy, ikke kjøps- eller salgsanbefalinger.

//@version=5
indicator("AI Copilot – nivåer og trendlinjer", overlay = true, max_lines_count = 60, max_labels_count = 60)

left       = input.int(3, "Svingpunkt: lys til venstre", minval = 1)
right      = input.int(3, "Svingpunkt: lys til høyre", minval = 1)
lookback   = input.int(300, "Antall lys bakover", minval = 50, maxval = 2000)
tolMult    = input.float(0.3, "Toleranse for nivå (x ATR 14)", step = 0.05)
minTouches = input.int(2, "Minst antall berøringer", minval = 1)
maxLevels  = input.int(6, "Maks antall nivåer", minval = 1, maxval = 20)
showTrend  = input.bool(true, "Vis trendlinjer")
showPoc    = input.bool(true, "Vis volum-POC og verdiområde")
bins       = input.int(60, "Volumprofil: antall prisnivåer", minval = 10, maxval = 200)

atr14 = ta.atr(14)
hiN = ta.highest(high, lookback)
loN = ta.lowest(low, lookback)
ph = ta.pivothigh(high, left, right)
pl = ta.pivotlow(low, left, right)

var float[] pivPrice = array.new_float()
var int[]   pivBar   = array.new_int()
var int[]   pivType  = array.new_int()   // 1 = topp, -1 = bunn

if not na(ph)
    array.push(pivPrice, ph)
    array.push(pivBar, bar_index - right)
    array.push(pivType, 1)
if not na(pl)
    array.push(pivPrice, pl)
    array.push(pivBar, bar_index - right)
    array.push(pivType, -1)
while array.size(pivBar) > 0 and array.get(pivBar, 0) < bar_index - lookback
    array.shift(pivPrice)
    array.shift(pivBar)
    array.shift(pivType)

var line[]  drawn  = array.new_line()
var label[] labels = array.new_label()

if barstate.islast
    for l in drawn
        line.delete(l)
    for lb in labels
        label.delete(lb)
    array.clear(drawn)
    array.clear(labels)

    // ---- Støtte og motstand: klynger av svingpunkter ----
    tol = nz(atr14, 1.0) * tolMult
    n = array.size(pivPrice)
    float[] cPrice = array.new_float()
    int[]   cCount = array.new_int()
    if n > 0
        idx = array.sort_indices(pivPrice, order.ascending)
        float sum = 0.0
        int cnt = 0
        float mean = na
        for k = 0 to n - 1
            p = array.get(pivPrice, array.get(idx, k))
            if cnt > 0 and math.abs(p - mean) <= tol
                sum += p
                cnt += 1
                mean := sum / cnt
            else
                if cnt > 0
                    array.push(cPrice, mean)
                    array.push(cCount, cnt)
                sum := p
                cnt := 1
                mean := p
        if cnt > 0
            array.push(cPrice, mean)
            array.push(cCount, cnt)

    // velg de sterke nivåene nærmest prisen
    float[] dist = array.new_float()
    if array.size(cPrice) > 0
        for k = 0 to array.size(cPrice) - 1
            array.push(dist, array.get(cCount, k) >= minTouches ? math.abs(array.get(cPrice, k) - close) : 1e12)
    if array.size(dist) > 0
        ord = array.sort_indices(dist, order.ascending)
        shown = 0
        for k = 0 to array.size(ord) - 1
            j = array.get(ord, k)
            if shown >= maxLevels or array.get(dist, j) >= 1e12
                break
            lvl = array.get(cPrice, j)
            col = lvl < close ? color.new(#26a69a, 0) : color.new(#ef5350, 0)
            array.push(drawn, line.new(bar_index - lookback, lvl, bar_index, lvl, extend = extend.right, color = col, style = line.style_dashed, width = 1))
            array.push(labels, label.new(bar_index + 3, lvl, (lvl < close ? "S " : "R ") + str.tostring(array.get(cCount, j)) + "x", style = label.style_label_left, color = color.new(col, 70), textcolor = color.white, size = size.tiny))
            shown += 1

    // ---- Trendlinjer: to siste stigende bunner / fallende topper ----
    if showTrend and n >= 2
        int lb2 = na
        int lb1 = na
        int hb2 = na
        int hb1 = na
        for k = n - 1 to 0
            t = array.get(pivType, k)
            if t == -1
                if na(lb2)
                    lb2 := k
                else if na(lb1)
                    lb1 := k
            if t == 1
                if na(hb2)
                    hb2 := k
                else if na(hb1)
                    hb1 := k
        if not na(lb1) and array.get(pivPrice, lb2) > array.get(pivPrice, lb1)
            array.push(drawn, line.new(array.get(pivBar, lb1), array.get(pivPrice, lb1), array.get(pivBar, lb2), array.get(pivPrice, lb2), extend = extend.right, color = #26a69a, width = 2))
        if not na(hb1) and array.get(pivPrice, hb2) < array.get(pivPrice, hb1)
            array.push(drawn, line.new(array.get(pivBar, hb1), array.get(pivPrice, hb1), array.get(pivBar, hb2), array.get(pivPrice, hb2), extend = extend.right, color = #ef5350, width = 2))

    // ---- Volum-POC og verdiområde (70 %) ----
    if showPoc
        hi = hiN
        lo = loN
        step = (hi - lo) / bins
        if step > 0
            float[] vol = array.new_float(bins, 0.0)
            for i = 0 to lookback - 1
                v = nz(volume[i], 1.0)
                i0 = math.max(0, math.min(bins - 1, int((low[i] - lo) / step)))
                i1 = math.max(0, math.min(bins - 1, int((high[i] - lo) / step)))
                share = v / (i1 - i0 + 1)
                for b = i0 to i1
                    array.set(vol, b, array.get(vol, b) + share)
            pocIdx = array.indexof(vol, array.max(vol))
            total = array.sum(vol)
            a = pocIdx
            z = pocIdx
            acc = array.get(vol, pocIdx)
            while acc < 0.7 * total and (a > 0 or z < bins - 1)
                up = z < bins - 1 ? array.get(vol, z + 1) : -1.0
                dn = a > 0 ? array.get(vol, a - 1) : -1.0
                if up >= dn
                    z += 1
                    acc += up
                else
                    a -= 1
                    acc += dn
            poc = lo + (pocIdx + 0.5) * step
            array.push(drawn, line.new(bar_index - lookback, poc, bar_index, poc, extend = extend.right, color = #f7a600, style = line.style_dotted, width = 2))
            array.push(labels, label.new(bar_index + 3, poc, "POC", style = label.style_label_left, color = color.new(#f7a600, 60), textcolor = color.white, size = size.tiny))
            array.push(drawn, line.new(bar_index - lookback, lo + a * step, bar_index, lo + a * step, color = color.new(#2962ff, 40), style = line.style_dotted))
            array.push(drawn, line.new(bar_index - lookback, lo + (z + 1) * step, bar_index, lo + (z + 1) * step, color = color.new(#2962ff, 40), style = line.style_dotted))
